[Unit]
Description=Sinden Lightgun driver (sindenrs)
# Game Mode (gamescope-session) and Desktop Mode (Plasma) both bring this target up.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
# Game Mode keeps its DISPLAY here; in Desktop Mode Plasma imports it into the manager.
EnvironmentFile=-%t/gamescope-environment
ExecStart=%h/.local/bin/sindenrs run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
